# Auth API endpoint
VITE_API_BASE_URL=http://localhost:8080

# Redirect destination after successful auth
# Point this to your main app (core-fe) domain in local/dev.
VITE_REDIRECT_URL=http://localhost:5174

# Comma-separated allowlist for `redirect` query param validation.
# Must include the origin used by VITE_REDIRECT_URL.
VITE_ALLOWED_REDIRECT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:5175

# Client logging
# VITE_LOG_LEVEL: debug | info | warn | error
VITE_LOG_LEVEL=debug
VITE_LOG_CONSOLE=true
